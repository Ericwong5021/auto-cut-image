{
  "name": "auto-cut-image",
  "version": "0.1.0",
  "description": "AI-powered image asset segmentation and background processing CLI/GUI application",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --recursive --filter '@auto-cut/*' dev",
    "build": "bun run --recursive --filter '@auto-cut/*' build",
    "test": "bun run --recursive --filter '@auto-cut/*' test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --recursive --filter '@auto-cut/*' typecheck",
    "clean": "bun run --recursive --filter '@auto-cut/*' clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "image",
    "segmentation",
    "background-removal",
    "ai",
    "cli",
    "gui",
    "bun",
    "typescript"
  ],
  "author": "Auto Cut Image Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/auto-cut-image.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/auto-cut-image/issues"
  },
  "homepage": "https://github.com/your-username/auto-cut-image#readme"
}
